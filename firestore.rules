rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ──────────────────────────────────────────────────
    
    // Check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Check if request user matches given userId
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Check if user has Admin role in /users collection
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ─── 1. Users Collection ────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn();
      allow update: if isOwner(userId) || isAdmin();
      allow create: if isSignedIn();
      allow delete: if isAdmin();
    }

    // ─── 2. Courts Collection ───────────────────────────────────────────────
    match /courts/{courtId} {
      // Public read access for court listings and prices
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── 3. Bookings Collection ─────────────────────────────────────────────
    match /bookings/{bookingId} {
      // Read access: Allowed if document doesn't exist yet (for availability checks), or user is owner/admin
      allow read: if isSignedIn() && (
        resource == null || resource.data.userId == request.auth.uid || isAdmin()
      );

      // Create access: Signed-in user creating a booking for themselves or Admin
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid || isAdmin()
      );

      // Update access: Customer can cancel own booking, Admin can update anything
      allow update: if isAdmin() || (
        resource != null &&
        isOwner(resource.data.userId) &&
        request.resource.data.status == 'cancelled'
      );

      // Delete access: Admin only (for unblocking maintenance slots)
      allow delete: if isAdmin();
    }

    // ─── 4. Payments Collection ─────────────────────────────────────────────
    match /payments/{paymentId} {
      allow read: if isSignedIn() && (
        resource == null || resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }
  }
}
